# Exemplo de arquivo .env para desenvolvimento
# Copie para `.env` e ajuste conforme necessário

# Banco de dados
POSTGRES_PASSWORD=postgres123
POSTGRES_CONNECTION_STRING=Host=db;Port=5432;Database=oficina_estoque;Username=postgres;Password=postgres123

# JWT
JWT_KEY=TechChallenge_SuperSecretKey_2024_Oficina_Mecanica_With_32_Chars!
JWT_ISSUER=TechChallenge.API
JWT_AUDIENCE=TechChallenge.Client
JWT_EXPIRACAO_MINUTOS=60

# SMTP (email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=oficina@exemplo.com
SMTP_PASSWORD=senha-de-app-aqui
SMTP_FROM=Oficina Mecânica <oficina@exemplo.com>
