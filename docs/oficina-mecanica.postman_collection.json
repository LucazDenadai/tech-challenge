{
  "info": {
    "name": "Oficina Mecânica — Tech Challenge",
    "_postman_id": "oficina-mecanica-tech-challenge",
    "description": "Collection completa do sistema de oficina mecânica.\n\n**Serviços:**\n- Atendimento: http://localhost:8080\n- Estoque: http://localhost:8081\n\n**Fluxo recomendado:**\n1. Health Check\n2. Registrar usuário → Login (captura token automaticamente)\n3. Cadastrar peça no Estoque (fonte da verdade)\n4. Cadastrar serviços, clientes e veículos no Atendimento\n5. Executar o fluxo completo da OS\n6. Verificar baixa automática no estoque via RabbitMQ",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_atendimento", "value": "http://localhost:8080", "type": "string" },
    { "key": "base_estoque",     "value": "http://localhost:8081", "type": "string" },
    { "key": "token",            "value": "", "type": "string" },
    { "key": "cliente_id",       "value": "", "type": "string" },
    { "key": "veiculo_id",       "value": "", "type": "string" },
    { "key": "peca_id",          "value": "", "type": "string" },
    { "key": "servico_id",       "value": "", "type": "string" },
    { "key": "usuario_id",       "value": "", "type": "string" },
    { "key": "os_id",            "value": "", "type": "string" },
    { "key": "os_numero",        "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "00 — Health Check",
      "item": [
        {
          "name": "Health Atendimento",
          "request": {
            "method": "GET",
            "url": "{{base_atendimento}}/health",
            "description": "Esperado: 200 Healthy"
          }
        },
        {
          "name": "Health Estoque",
          "request": {
            "method": "GET",
            "url": "{{base_estoque}}/health",
            "description": "Esperado: 200 Healthy"
          }
        }
      ]
    },
    {
      "name": "01 — Autenticação",
      "item": [
        {
          "name": "Registrar Usuário Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_atendimento}}/auth/registrar",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Admin Oficina\",\n  \"email\": \"admin@oficina.com\",\n  \"senha\": \"Admin@123\",\n  \"perfil\": 0\n}"
            },
            "description": "Perfil: 0=Admin, 1=Atendente, 2=Mecanico"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "  console.log('Token salvo.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_atendimento}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@oficina.com\",\n  \"senha\": \"Admin@123\"\n}"
            },
            "description": "Salva o JWT em {{token}} automaticamente via script de test"
          }
        }
      ]
    },
    {
      "name": "02 — Usuários",
      "item": [
        {
          "name": "Listar Usuários",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_atendimento}}/usuarios",
            "description": "Requer perfil Admin"
          }
        },
        {
          "name": "Buscar por E-mail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_atendimento}}/usuarios?email=admin@oficina.com",
              "host": ["{{base_atendimento}}"],
              "path": ["usuarios"],
              "query": [{ "key": "email", "value": "admin@oficina.com" }]
            }
          }
        },
        {
          "name": "Criar Usuário Mecanico",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('usuario_id', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_atendimento}}/usuarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João Mecânico\",\n  \"email\": \"mecanico@oficina.com\",\n  \"senha\": \"Mecanico@123\",\n  \"perfil\": 2\n}"
            }
          }
        },
        {
          "name": "Obter Usuário por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_atendimento}}/usuarios/{{usuario_id}}"
          }
        },
        {
          "name": "Atualizar Usuário",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_atendimento}}/usuarios/{{usuario_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João Mecânico Silva\",\n  \"email\": \"mecanico@oficina.com\",\n  \"perfil\": 2\n}"
            }
          }
        },
        {
          "name": "Desativar Usuário",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_atendimento}}/usuarios/{{usuario_id}}"
          }
        }
      ]
    },
    {
      "name": "03 — Estoque / Peças (fonte da verdade)",
      "description": "O Estoque é a fonte da verdade para peças. Cadastre aqui PRIMEIRO. O ID gerado aqui é o que será usado na OS do Atendimento.",
      "item": [
        {
          "name": "Criar Peça",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('peca_id', json.id);",
                  "  console.log('Peça ID salvo:', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_estoque}}/estoque/pecas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Pastilha de Freio Dianteira\",\n  \"descricao\": \"Pastilha de freio para veículos de passeio\",\n  \"valor\": 89.90,\n  \"quantidadeEstoque\": 20\n}"
            },
            "description": "O ID gerado aqui deve ser usado ao adicionar peças à OS no Atendimento"
          }
        },
        {
          "name": "Listar Peças",
          "request": {
            "method": "GET",
            "url": "{{base_estoque}}/estoque/pecas"
          }
        },
        {
          "name": "Obter Peça por ID",
          "request": {
            "method": "GET",
            "url": "{{base_estoque}}/estoque/pecas/{{peca_id}}",
            "description": "Verificar estoque atual. Após finalizar OS deve reduzir conforme itens da OS"
          }
        },
        {
          "name": "Atualizar Peça",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_estoque}}/estoque/pecas/{{peca_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{peca_id}}\",\n  \"nome\": \"Pastilha de Freio Dianteira Premium\",\n  \"descricao\": \"Pastilha de freio premium para veículos de passeio\",\n  \"valor\": 99.90\n}"
            }
          }
        },
        {
          "name": "Consultar Disponibilidade",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_estoque}}/estoque/disponibilidade",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itens\": [\n    { \"pecaId\": \"{{peca_id}}\", \"quantidade\": 2 }\n  ]\n}"
            },
            "description": "Verifica se há estoque suficiente para os itens informados"
          }
        },
        {
          "name": "Remover Peça",
          "request": {
            "method": "DELETE",
            "url": "{{base_estoque}}/estoque/pecas/{{peca_id}}"
          }
        }
      ]
    },
