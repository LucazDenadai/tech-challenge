    {
      "name": "07 — Fluxo OS End-to-End",
      "description": "Fluxo completo de uma Ordem de Serviço.\n\nMáquina de estados:\nRecebida(1) → EmDiagnostico(2) → AguardandoAprovacao(3) → EmExecucao(4) → Finalizada(5) → Entregue(6)\n\nAo Finalizar a OS, um evento é publicado no RabbitMQ e o Estoque reduz automaticamente o estoque das peças usadas.",
      "item": [
        {
          "name": "1. Abrir OS",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('os_id', json.id);",
                  "  console.log('OS ID:', json.id);",
                  "}",
                  "if (json.numero) pm.collectionVariables.set('os_numero', json.numero);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_atendimento}}/ordens-servico",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{cliente_id}}\",\n  \"veiculoId\": \"{{veiculo_id}}\",\n  \"descricaoProblema\": \"Barulho ao frear — suspeita de desgaste nas pastilhas\",\n  \"pecas\": [\n    { \"pecaId\": \"{{peca_id}}\", \"quantidade\": 2 }\n  ]\n}"
            },
            "description": "O array 'pecas' na abertura é apenas para verificar disponibilidade em estoque. As peças são adicionadas formalmente na etapa 3."
          }
        },
        {
          "name": "2. Status → EmDiagnostico",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_atendimento}}/ordens-servico/{{os_id}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"novoStatus\": 2\n}"
            },
            "description": "1=Recebida, 2=EmDiagnostico, 3=AguardandoAprovacao, 4=EmExecucao, 5=Finalizada, 6=Entregue"
          }
        },
        {
          "name": "3. Adicionar Peça à OS",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_atendimento}}/ordens-servico/{{os_id}}/pecas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pecaId\": \"{{peca_id}}\",\n  \"quantidade\": 2\n}"
            },
            "description": "Só permitido em EmDiagnostico ou EmExecucao. O pecaId DEVE ser o ID cadastrado no Estoque ({{peca_id}})"
          }
        },
        {
          "name": "3b. Adicionar Serviço à OS",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_atendimento}}/ordens-servico/{{os_id}}/servicos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"servicoId\": \"{{servico_id}}\"\n}"
            },
            "description": "Só permitido em EmDiagnostico ou EmExecucao"
          }
        },
        {
          "name": "4. Status → AguardandoAprovacao",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_atendimento}}/ordens-servico/{{os_id}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"novoStatus\": 3\n}"
            }
          }
        },
        {
          "name": "5. Aprovar Orçamento",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_atendimento}}/ordens-servico/{{os_id}}/orcamento",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aprovado\": true\n}"
            },
            "description": "Aprovado=true avança para EmExecucao. Aprovado=false cancela (Recusado)"
          }
        },
        {
          "name": "6. Status → EmExecucao",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_atendimento}}/ordens-servico/{{os_id}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"novoStatus\": 4\n}"
            }
          }
        },
        {
          "name": "7. Status → Finalizada  ★ publica evento RabbitMQ",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_atendimento}}/ordens-servico/{{os_id}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"novoStatus\": 5\n}"
            },
            "description": "Publica OsFinalizadaEvent no RabbitMQ. O consumer do Estoque processa e reduz o estoque das peças."
          }
        },
        {
          "name": "8. Status → Entregue",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_atendimento}}/ordens-servico/{{os_id}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"novoStatus\": 6\n}"
            }
          }
        }
      ]
    },
    {
      "name": "08 — Consultas OS",
      "item": [
        {
          "name": "Listar Todas as OS",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_atendimento}}/ordens-servico"
